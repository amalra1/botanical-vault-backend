DB_PORT_EXTERNAL=5432
DB_NAME=botanical_vault
DB_USERNAME=postgres
DB_PASSWORD=postgres
APP_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/botanical_vault
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
DB_POOL_SIZE=3

JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_SECRET_OF_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=604800000

APP_ADMIN_EMAIL=architect@example.com
APP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

CORS_ALLOWED_ORIGINS=http://localhost:3000

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=./storage
GCP_BUCKET_NAME=
GCP_SIGNED_URL_MINUTES=60
